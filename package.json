{
  "name": "latexide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first LaTeX IDE in the browser",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false",
    "assets": "node scripts/copy-assets.mjs",
    "thesis-pack": "bash scripts/build-thesis-pack.sh",
    "test:thesis": "node scripts/test-thesis.mjs",
    "fb": "firebase",
    "deploy:firebase": "firebase deploy --only auth,firestore:rules,firestore:indexes,storage",
    "emulators": "firebase emulators:start --only auth,firestore,storage"
  },
  "keywords": [
    "latex",
    "wasm",
    "tectonic",
    "pwa"
  ],
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.2",
    "firebase": "^11.10.0",
    "glyphtex-engine": "^0.1.4",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.2",
    "monaco-editor": "^0.45.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dictionary-de": "^3.0.0",
    "dictionary-en-gb": "^3.0.0",
    "firebase-tools": "^15.35.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5"
  }
}
