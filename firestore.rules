rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(project) {
      return signedIn() && request.auth.uid == project.data.ownerUid;
    }

    function isMember(project) {
      return signedIn() &&
        request.auth.token.email in project.data.memberEmails;
    }

    function isEditor(project) {
      return isOwner(project) ||
        (isMember(project) &&
          project.data.memberRoles[request.auth.token.email] == 'editor');
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /projects/{projectId} {
      allow read: if isOwner(resource) || isMember(resource);

      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerEmail == request.auth.token.email;

      allow update: if isOwner(resource) ||
        (isEditor(resource) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'mainFile',
            'currentVersionId',
            'revision',
            'size',
            'updatedAt'
          ]));

      allow delete: if isOwner(resource);

      match /versions/{versionId} {
        allow read: if isOwner(projectDoc(projectId)) ||
          isMember(projectDoc(projectId));

        allow create: if isEditor(projectDoc(projectId));

        allow update, delete: if isOwner(projectDoc(projectId));
      }
    }
  }
}
